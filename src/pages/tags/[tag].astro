---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => (p.data.tags ?? []).includes(tag))
        .sort((a, b) => b.data.date.localeCompare(a.data.date)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <h1 class="tag">#{tag}</h1>
  <ul class="list">
    {posts.map((p) => (
      <li>
        <a class="title" href={`/blog/${p.id}`}>{p.data.title}</a>
        <div class="meta"><span class="date">{p.data.date}</span></div>
      </li>
    ))}
  </ul>
  <p style="margin-top:28px"><a href="/tags">← 全部标签</a></p>
</BaseLayout>

<style>
  .tag { font-size: 24px; margin: 0 0 16px; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .list li { padding: 14px 4px; border-bottom: 1px solid var(--border); }
  .list li:last-child { border-bottom: none; }
  .title { font-size: 17px; font-weight: 600; color: var(--text); }
  .title:hover { color: var(--accent); text-decoration: none; }
  .meta { margin-top: 5px; }
  .date { color: var(--muted); font-size: 13px; }
</style>
