---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} · 笔记`} description={post.data.excerpt ?? ""}>
  <article class="prose">
    <div class="meta">
      <span class="date">{post.data.date}</span>
      {post.data.tags?.length ? (
        <span class="tags">{post.data.tags.map((t) => <a class="pill" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}</span>
      ) : null}
    </div>
    <h1>{post.data.title}</h1>
    <div class="body"><Content /></div>
    <p style="margin-top:36px"><a href="/">← 返回笔记</a></p>
  </article>
</BaseLayout>

<style>
  .prose { animation: fadeUp .5s ease both; }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .date { color: var(--muted); font-size: 14px; }
  .tags { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .prose h1 { font-size: 38px; font-weight: 800; line-height: 1.25; margin: 0 0 22px; letter-spacing: .3px; }
  .body { animation: fadeUp .6s ease .12s both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
</style>
