---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={`${post.data.title} · 笔记`} description={post.data.excerpt ?? ""}>
  <div class="layout">
    <article class="prose">
      <p class="date">{post.data.date}</p>
      <div class="pills">
        <a class="pill" href={`/blog?cat=${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
        {post.data.tags?.map((t) => <a class="pill" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
      </div>
      <h1>{post.data.title}</h1>
      <Content />
      <p style="margin-top:40px"><a href="/blog">← 返回全部笔记</a></p>
    </article>

    {toc.length > 1 && (
      <aside class="toc">
        <p class="toc-title">本页目录</p>
        <ul>
          {toc.map((h) => (
            <li class={`lvl-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .layout { display: grid; grid-template-columns: minmax(0,1fr) 200px; gap: 36px; align-items: start; }
  .prose { max-width: 100%; }
  .prose .date { color: var(--muted); font-size: 14px; margin: 0 0 8px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 10px; }
  .prose h1 { font-size: 30px; margin: 0 0 18px; }
  .toc { position: sticky; top: 80px; border-left: 1px solid var(--border); padding-left: 14px; font-size: 13px; }
  .toc-title { color: var(--muted); font-size: 12px; margin: 0 0 10px; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--text); text-decoration: none; }
  .toc .lvl-3 { padding-left: 12px; font-size: 12px; }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } .toc { display: none; } }
</style>
