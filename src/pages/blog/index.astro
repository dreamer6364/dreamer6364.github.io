---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
const cats = [...new Set(posts.map((p) => p.data.category))];
const all = [...posts].sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="全部笔记">
  <h1>全部笔记</h1>

  <div class="filters" id="filters">
    <button class="chip active" data-cat="全部">全部 ({all.length})</button>
    {cats.map((c) => (
      <button class="chip" data-cat={c}>{c} ({posts.filter((p) => p.data.category === c).length})</button>
    ))}
  </div>

  {all.length === 0 ? (
    <p class="empty">还没有笔记。去 <code>src/content/posts/</code> 按分类建文件夹，放一篇 <code>.md</code> 即可。</p>
  ) : (
    <ul class="list" id="list">
      {all.map((p) => (
        <li data-cat={p.data.category}>
          <a href={`/blog/${p.id}`}>
            <span class="t">{p.data.title}</span>
            <span class="m">{p.data.date} · <span class="pill">{p.data.category}</span></span>
            {p.data.tags?.length ? <span class="tags">{p.data.tags.map((t) => `#${t}`).join("  ")}</span> : null}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<script>
  const filters = document.getElementById("filters");
  const list = document.getElementById("list");
  filters?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".chip") as HTMLElement | null;
    if (!btn) return;
    const cat = btn.dataset.cat;
    filters.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
    btn.classList.add("active");
    list?.querySelectorAll("li").forEach((li) => {
      const el = li as HTMLElement;
      el.style.display = !cat || cat === "全部" || el.dataset.cat === cat ? "" : "none";
    });
  });
</script>

<style>
  h1 { font-size: 30px; margin: 0 0 18px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .chip {
    cursor: pointer; font-size: 14px; padding: 6px 14px; border-radius: 999px;
    background: var(--surface-2); border: 1px solid var(--border); color: var(--muted);
  }
  .chip.active { background: var(--accent); color: #06121f; border-color: var(--accent); font-weight: 600; }
  .chip:hover { color: var(--text); }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .list a {
    display: grid; gap: 6px; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px 18px; color: var(--text);
  }
  .list a:hover { text-decoration: none; border-color: var(--accent); }
  .list .t { font-size: 17px; font-weight: 700; }
  .list .m { color: var(--muted); font-size: 13px; }
  .list .tags { color: #ffa657; font-size: 13px; }
</style>
