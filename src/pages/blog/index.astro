---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="我的笔记">
  {all.length === 0 ? (
    <p class="empty">还没有笔记。去 <code>src/content/posts/</code> 放一篇 <code>.md</code> 即可。</p>
  ) : (
    <ul class="list">
      {all.map((p) => (
        <li>
          <a class="title" href={`/blog/${p.id}`}>{p.data.title}</a>
          <div class="meta">
            <span class="date">{p.data.date}</span>
            {p.data.tags?.length ? (
              <span class="tags">{p.data.tags.map((t) => <a class="pill" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}</span>
            ) : null}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .list li { padding: 16px 4px; border-bottom: 1px solid var(--border); opacity: 0; animation: fadeUp .45s ease forwards; }
  .list li:nth-child(1) { animation-delay: .05s; }
  .list li:nth-child(2) { animation-delay: .12s; }
  .list li:nth-child(3) { animation-delay: .19s; }
  .list li:nth-child(4) { animation-delay: .26s; }
  .list li:nth-child(5) { animation-delay: .33s; }
  .list li:nth-child(n+6) { animation-delay: .4s; }
  .list li:last-child { border-bottom: none; }
  .title { font-size: 24px; font-weight: 700; color: var(--text); letter-spacing: .2px; }
  .title:hover { color: var(--accent); text-decoration: none; }
  .meta { margin-top: 6px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .date { color: var(--muted); font-size: 13px; }
  .tags { display: inline-flex; gap: 6px; flex-wrap: wrap; }
</style>
