---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
const cats = [...new Set(posts.map((p) => p.data.category))];
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
---

<BaseLayout title="关于">
  <h1>关于</h1>
  <p class="lead">这是一个用 <strong>Astro</strong> 搭建的本地优先 Markdown 笔记站。所有笔记都是纯 <code>.md</code> 文本，写在 <code>src/content/posts/</code> 下，按分类建子文件夹即可。</p>
  <ul>
    <li>共 <strong>{posts.length}</strong> 篇笔记</li>
    <li><strong>{cats.length}</strong> 个分类</li>
    <li><strong>{allTags.length}</strong> 个标签</li>
  </ul>
  <p style="margin-top:24px"><a href="/">← 返回首页</a></p>
</BaseLayout>

<style>
  h1 { font-size: 30px; margin: 0 0 12px; }
  .lead { color: var(--muted); }
  .lead code { background: var(--surface-2); padding: 2px 6px; border-radius: 6px; color: #ffa657; }
</style>
