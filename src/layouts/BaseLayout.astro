---
const {
  title = "我的笔记",
  description = "用 Astro 搭建的个人笔记站",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">📒 我的笔记</a>
        <nav>
          <a href="/">首页</a>
          <a href="/blog">笔记</a>
          <a href="/tags">标签</a>
          <a href="/about">关于</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer>
      <p>© {new Date().getFullYear()} 我的笔记 · 由 Astro 驱动</p>
    </footer>

    <style is:global>
      :root {
        --bg: #0e1117;
        --surface: #161b22;
        --surface-2: #1c2230;
        --border: #2a313c;
        --text: #e6edf3;
        --muted: #8b949e;
        --accent: #58a6ff;
        --radius: 12px;
        --max: 860px;
        --font: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: var(--font); line-height: 1.75; font-size: 16px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .site-header {
        position: sticky; top: 0; z-index: 20;
        background: rgba(14,17,23,.8); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .bar {
        max-width: var(--max); margin: 0 auto; padding: 14px 20px;
        display: flex; align-items: center; justify-content: space-between;
      }
      .brand { font-weight: 700; color: var(--text); font-size: 17px; }
      .brand:hover { text-decoration: none; }
      nav { display: flex; gap: 18px; }
      nav a { color: var(--muted); font-size: 14px; }
      nav a:hover { color: var(--text); text-decoration: none; }

      .wrap { max-width: var(--max); margin: 0 auto; padding: 40px 20px 72px; }
      footer {
        border-top: 1px solid var(--border); padding: 24px 20px;
        text-align: center; color: var(--muted); font-size: 13px;
      }

      /* 文章正文排版 */
      .prose { font-size: 16px; }
      .prose :global(h2) { margin-top: 32px; font-size: 22px; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
      .prose :global(h3) { margin-top: 24px; font-size: 18px; }
      .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 14px 0; }
      .prose :global(li) { margin: 6px 0; }
      .prose :global(code) {
        background: var(--surface-2); padding: 2px 6px; border-radius: 6px;
        font-size: .9em; color: #ffa657;
      }
      .prose :global(pre) {
        background: #0b0e14; border: 1px solid var(--border);
        padding: 16px; border-radius: 10px; overflow: auto; font-size: 14px;
      }
      .prose :global(pre code) { background: none; padding: 0; color: #c9d1d9; }
      .prose :global(blockquote) {
        margin: 16px 0; padding: 4px 16px; border-left: 3px solid var(--accent);
        color: var(--muted);
      }
      .prose :global(table) { border-collapse: collapse; width: 100%; margin: 16px 0; }
      .prose :global(th), .prose :global(td) { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
      .prose :global(img) { max-width: 100%; border-radius: 8px; }

      .pill {
        display: inline-block; font-size: 12px; padding: 2px 9px; border-radius: 999px;
        background: var(--surface-2); border: 1px solid var(--border); color: var(--muted);
      }
      .pill:hover { color: var(--text); border-color: var(--accent); text-decoration: none; }
      .empty {
        color: var(--muted); background: var(--surface); border: 1px dashed var(--border);
        border-radius: var(--radius); padding: 28px; text-align: center;
      }
      .empty code { background: var(--surface-2); padding: 2px 6px; border-radius: 6px; color: #ffa657; }
    </style>
  </body>
</html>
